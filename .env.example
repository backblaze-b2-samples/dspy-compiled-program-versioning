# Backblaze B2 (required) — S3-compatible API.
# The S3 endpoint is derived from B2_REGION as https://s3.<region>.backblazeb2.com
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=your-region

# Optional: base URL for building public object links (only needed for public
# buckets). Leave unset for private buckets — the app works without it.
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.us-east-005.backblazeb2.com

# Example of what filled-in B2 values look like (placeholders — replace all):
# B2_APPLICATION_KEY_ID=<your ~24-char keyID from B2>
# B2_APPLICATION_KEY=<your application key from B2, shown once>
# B2_BUCKET_NAME=my-dspy-runs
# B2_REGION=us-east-005

# Local Ollama model that DSPy compiles/evaluates against (no API key needed).
# Install Ollama (https://ollama.com) and run `ollama pull llama3.2` first.
# For the fastest demo run, use a tiny model, e.g. OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
